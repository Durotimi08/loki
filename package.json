{
  "name": "loki",
  "private": true,
  "version": "0.0.0",
  "description": "Schema-agnostic, plug-in transaction tracking and bookkeeping library — Prisma for money-movement records.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "LOKI_INTEGRATION=1 vitest run",
    "test:all": "LOKI_INTEGRATION=1 vitest run",
    "test:types": "vitest --typecheck.only run",
    "bench": "pnpm --filter @loki/bench bench",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "pack:all": "pnpm build && rm -rf dist-tarballs && mkdir -p dist-tarballs && pnpm -r --filter \"./packages/*\" --filter \"!@loki/bench\" exec pnpm pack --pack-destination ../../dist-tarballs",
    "dev:setup": "bash scripts/dev-setup.sh",
    "dev:watch": "pnpm -r --parallel --filter \"./packages/*\" --filter \"!@loki/bench\" --filter \"!@loki/cli\" exec tsup src/index.ts --format esm,cjs --dts --watch",
    "ship": "bash scripts/ship.sh",
    "hooks:install": "ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push && chmod +x scripts/hooks/pre-push && echo 'Installed pre-push hook'"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "argon2"]
  }
}
