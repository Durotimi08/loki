{
  "name": "@loki/client",
  "version": "0.0.0",
  "description": "Codegen target for the Loki typed runtime client.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loki/core": "workspace:*",
    "@standard-schema/spec": "1.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "testcontainers": "^10.13.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
