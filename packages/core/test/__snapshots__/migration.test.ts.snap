ALTER TABLE "txn_anomalies" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "outbox_tenant_isolation" ON "outbox";

ALTER TABLE "outbox" DISABLE ROW LEVEL SECURITY;

