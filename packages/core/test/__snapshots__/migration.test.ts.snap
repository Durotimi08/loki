exports[`planInitialMigration — Chidori fixture > toUpSql matches the golden snapshot 1`] = `
"DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'ledger_app') THEN
    CREATE ROLE "ledger_app" NOLOGIN;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'ledger_admin') THEN
    CREATE ROLE "ledger_admin" NOLOGIN;
  END IF;
END
$$;

CREATE TABLE "tenants" (
  "id"         text PRIMARY KEY,
  "name"       text NOT NULL,
  "mode"       text NOT NULL CHECK ("mode" IN ('db', 'schema', 'row')),
  "state"      text NOT NULL CHECK ("state" IN ('active', 'suspended', 'deleted')),
  "created_at" timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE "accounts" (
  "id"                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"           text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "owner_actor_type"    text NOT NULL,
  "owner_actor_id"      text NOT NULL,
  "name"                text NOT NULL,
  "parent_account_id"   uuid REFERENCES "accounts"("id") ON DELETE RESTRICT,
  "shard_index"         int NOT NULL DEFAULT 0 CHECK ("shard_index" >= 0),
  "currency"            text NOT NULL CHECK (length("currency") > 0),
  "balance"             numeric(38,0) NOT NULL DEFAULT 0,
  "created_at"          timestamptz NOT NULL DEFAULT now(),
  CHECK ("owner_actor_type" IN ('User', 'Driver', 'Company')),
  CHECK (("owner_actor_type" = 'User' AND "name" IN ('wallet'))
      OR ("owner_actor_type" = 'Driver' AND "name" IN ('balance'))
      OR ("owner_actor_type" = 'Company' AND "name" IN ('revenue', 'promo_pool', 'escrow', 'chargebacks'))),
  UNIQUE ("tenant_id", "owner_actor_type", "owner_actor_id", "name", "currency", "shard_index")
);

CREATE TABLE "txn_records" (
  "id"                      uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"               text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "type"                    text NOT NULL,
  "state"                   text NOT NULL,
  "version"                 int NOT NULL DEFAULT 0,
  "active_keys"             jsonb NOT NULL DEFAULT '[]'::jsonb,
  "participants"            jsonb NOT NULL DEFAULT '{}'::jsonb,
  "created_by_actor_type"   text NOT NULL,
  "created_by_actor_id"     text NOT NULL,
  "compromised"             boolean NOT NULL DEFAULT FALSE,
  "schema_version"          int NOT NULL DEFAULT 1,
  "created_at"              timestamptz NOT NULL DEFAULT now(),
  "updated_at"              timestamptz NOT NULL DEFAULT now(),
  CHECK ("type" IN ('DeliveryPayment')),
  CHECK (
         ("type" = 'DeliveryPayment' AND "state" IN ('pending', 'completed', 'failed', 'refunded'))
       )
);

CREATE TABLE "txn_transitions" (
  "id"                  text PRIMARY KEY CHECK (length("id") = 26),
  "tenant_id"           text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "txn_id"              uuid NOT NULL REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "type"                text NOT NULL,
  "from_state"          text,
  "to_state"            text NOT NULL,
  "name"                text NOT NULL,
  "schema_version"      int NOT NULL DEFAULT 1,
  "actor_type"          text NOT NULL,
  "actor_id"            text NOT NULL,
  "payload"             jsonb NOT NULL DEFAULT '{}'::jsonb,
  "idempotency_key"     text NOT NULL,
  "trace_id"            text,
  "prev_hash"           bytea,
  "row_hash"            bytea NOT NULL,
  "postings_checksum"   bytea NOT NULL,
  "reverses"            text REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "occurred_at"         timestamptz NOT NULL DEFAULT now(),
  CHECK (
         ("name" = '_init')
      OR ("type" = 'DeliveryPayment' AND "name" IN ('pay', 'cancel', 'refund'))
       ),
  CHECK (
         "from_state" IS NULL
      OR ("type" = 'DeliveryPayment' AND ("from_state" IN ('pending', 'completed')))
       ),
  CHECK (
         ("type" = 'DeliveryPayment' AND "to_state" IN ('pending', 'completed', 'failed', 'refunded'))
       ),
  UNIQUE ("tenant_id", "txn_id", "idempotency_key")
);

CREATE TABLE "txn_keys" (
  "id"                          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"                   text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "txn_id"                      uuid NOT NULL REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "name"                        text NOT NULL,
  "granted_by_transition_id"    text NOT NULL REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "consumed_by_transition_id"   text REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "expires_at"                  timestamptz,
  "status"                      text NOT NULL CHECK ("status" IN ('active', 'consumed', 'expired')),
  CHECK ("name" IN ('refund'))
);

CREATE TABLE "postings" (
  "id"              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"       text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "transition_id"   text NOT NULL REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "account_id"      uuid NOT NULL REFERENCES "accounts"("id") ON DELETE RESTRICT,
  "amount"          numeric(38,0) NOT NULL CHECK ("amount" >= 0),
  "direction"       text NOT NULL CHECK ("direction" IN ('D', 'C')),
  "occurred_at"     timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE "outbox" (
  "id"                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"           text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "txn_id"              uuid NOT NULL REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "transition_id"       text NOT NULL REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "event"               text NOT NULL,
  "intent"              text,
  "payload"             jsonb NOT NULL DEFAULT '{}'::jsonb,
  "delivered_at"        timestamptz,
  "failed_at"           timestamptz,
  "attempts"            int NOT NULL DEFAULT 0,
  "next_attempt_at"     timestamptz NOT NULL DEFAULT now(),
  "last_error"          text,
  CHECK ("event" IN ('delivery.paid', 'delivery.cancelled', 'delivery.refunded'))
);

CREATE TABLE "txn_anomalies" (
  "id"              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"       text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "detected_at"     timestamptz NOT NULL DEFAULT now(),
  "check_name"      text NOT NULL,
  "txn_id"          uuid REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "account_id"      uuid REFERENCES "accounts"("id") ON DELETE RESTRICT,
  "expected"        jsonb,
  "observed"        jsonb,
  "severity"        text NOT NULL CHECK ("severity" IN ('warn', 'error', 'critical')),
  "resolved_at"     timestamptz,
  "resolved_by"     text,
  "resolution"      text
);

CREATE TABLE "txn_scheduled" (
  "id"                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"             text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "txn_id"                uuid NOT NULL REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "name"                  text NOT NULL,
  "run_at"                timestamptz NOT NULL,
  "actor_type"            text NOT NULL,
  "actor_id"              text NOT NULL,
  "payload"               jsonb NOT NULL DEFAULT '{}'::jsonb,
  "with_key"              uuid REFERENCES "txn_keys"("id") ON DELETE RESTRICT,
  "idempotency_key"       text NOT NULL,
  "status"                text NOT NULL CHECK ("status" IN ('pending', 'completed', 'cancelled', 'failed')),
  "attempts"              int NOT NULL DEFAULT 0,
  "last_error"            text,
  "fired_at"              timestamptz,
  "fired_transition_id"   text REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "created_at"            timestamptz NOT NULL DEFAULT now(),
  CHECK ("name" IN ('pay', 'cancel', 'refund')),
  UNIQUE ("tenant_id", "txn_id", "idempotency_key")
);

CREATE TABLE "fx_rates" (
  "id"              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"       text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "base_currency"   text NOT NULL,
  "quote_currency"  text NOT NULL,
  "rate"            numeric(38, 18) NOT NULL CHECK ("rate" > 0),
  "fixed_at"        timestamptz NOT NULL,
  "expires_at"      timestamptz,
  "source"          text NOT NULL,
  "created_at"      timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX "fx_rates_lookup_idx" ON "fx_rates"
  ("tenant_id", "base_currency", "quote_currency", "fixed_at" DESC);

CREATE TABLE "txn_holds" (
  "id"                          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"                   text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "txn_id"                      uuid REFERENCES "txn_records"("id") ON DELETE RESTRICT,
  "hold_account_id"             uuid NOT NULL REFERENCES "accounts"("id") ON DELETE RESTRICT,
  "amount"                      numeric(38, 0) NOT NULL CHECK ("amount" > 0),
  "status"                      text NOT NULL CHECK ("status" IN ('placed', 'released', 'expired', 'captured')),
  "expires_at"                  timestamptz,
  "released_by_transition_id"   text REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "placed_at"                   timestamptz NOT NULL DEFAULT now(),
  "released_at"                 timestamptz
);
CREATE INDEX "txn_holds_tenant_status_idx" ON "txn_holds"
  ("tenant_id", "status", "expires_at");

CREATE TABLE "txn_disputes" (
  "id"                       uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  "tenant_id"                text NOT NULL REFERENCES "tenants"("id") ON DELETE RESTRICT,
  "original_transition_id"   text NOT NULL REFERENCES "txn_transitions"("id") ON DELETE RESTRICT,
  "status"                   text NOT NULL CHECK ("status" IN ('open', 'resolved_customer', 'resolved_merchant', 'expired')),
  "opened_at"                timestamptz NOT NULL DEFAULT now(),
  "deadline_at"              timestamptz,
  "resolved_at"              timestamptz,
  "resolution"               text,
  "reason"                   text
);
CREATE INDEX "txn_disputes_tenant_status_idx" ON "txn_disputes"
  ("tenant_id", "status", "deadline_at");

CREATE INDEX "txn_records_type_state_idx"
  ON "txn_records" (
    "tenant_id",
    "type",
    "state",
    "updated_at" DESC
  );

CREATE INDEX "txn_records_creator_idx"
  ON "txn_records" (
    "tenant_id",
    "created_by_actor_type",
    "created_by_actor_id",
    "updated_at" DESC
  );

CREATE INDEX "txn_transitions_trace_idx"
  ON "txn_transitions" (
    "tenant_id",
    "txn_id",
    "id" ASC
  );

CREATE INDEX "txn_transitions_actor_idx"
  ON "txn_transitions" (
    "tenant_id",
    "actor_type",
    "actor_id",
    "occurred_at" DESC,
    "id" DESC
  );

CREATE INDEX "postings_account_history_idx"
  ON "postings" (
    "tenant_id",
    "account_id",
    "occurred_at" DESC,
    "id" DESC
  );

CREATE INDEX "postings_transition_idx"
  ON "postings" (
    "tenant_id",
    "transition_id"
  );

CREATE INDEX "txn_keys_active_idx"
  ON "txn_keys" (
    "tenant_id",
    "txn_id",
    "name"
  )
  WHERE "status" = 'active';

CREATE INDEX "outbox_drain_idx"
  ON "outbox" (
    "tenant_id",
    "next_attempt_at",
    "id"
  )
  WHERE "delivered_at" IS NULL AND "failed_at" IS NULL;

CREATE INDEX "txn_anomalies_severity_idx"
  ON "txn_anomalies" (
    "tenant_id",
    "severity",
    "detected_at" DESC
  );

CREATE INDEX "txn_scheduled_due_idx"
  ON "txn_scheduled" (
    "tenant_id",
    "run_at",
    "id"
  )
  WHERE "status" = 'pending';

CREATE UNIQUE INDEX "txn_transitions_init_idem_idx"
  ON "txn_transitions" ("tenant_id", "idempotency_key")
  WHERE "name" = '_init';

ALTER TABLE "accounts" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "accounts" FORCE ROW LEVEL SECURITY;

CREATE POLICY "accounts_tenant_isolation" ON "accounts"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_records" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_records" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_records_tenant_isolation" ON "txn_records"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_transitions" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_transitions" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_transitions_tenant_isolation" ON "txn_transitions"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_keys" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_keys" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_keys_tenant_isolation" ON "txn_keys"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "postings" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "postings" FORCE ROW LEVEL SECURITY;

CREATE POLICY "postings_tenant_isolation" ON "postings"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "outbox" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "outbox" FORCE ROW LEVEL SECURITY;

CREATE POLICY "outbox_tenant_isolation" ON "outbox"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_anomalies" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_anomalies" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_anomalies_tenant_isolation" ON "txn_anomalies"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_scheduled" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_scheduled" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_scheduled_tenant_isolation" ON "txn_scheduled"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "fx_rates" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "fx_rates" FORCE ROW LEVEL SECURITY;

CREATE POLICY "fx_rates_tenant_isolation" ON "fx_rates"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_holds" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_holds" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_holds_tenant_isolation" ON "txn_holds"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

ALTER TABLE "txn_disputes" ENABLE ROW LEVEL SECURITY;

ALTER TABLE "txn_disputes" FORCE ROW LEVEL SECURITY;

CREATE POLICY "txn_disputes_tenant_isolation" ON "txn_disputes"
  USING ("tenant_id" = current_setting('loki.tenant_id', true))
  WITH CHECK ("tenant_id" = current_setting('loki.tenant_id', true));

GRANT SELECT, INSERT, UPDATE, DELETE ON
  "tenants",
  "accounts",
  "txn_records",
  "txn_transitions",
  "txn_keys",
  "postings",
  "outbox",
  "txn_anomalies",
  "txn_scheduled",
  "fx_rates",
  "txn_holds",
  "txn_disputes"
TO "ledger_admin";

GRANT SELECT ON
  "tenants",
  "accounts",
  "txn_records",
  "txn_transitions",
  "txn_keys",
  "postings",
  "outbox",
  "txn_anomalies",
  "txn_scheduled",
  "fx_rates",
  "txn_holds",
  "txn_disputes"
TO "ledger_app";

GRANT INSERT ON "txn_transitions" TO "ledger_app";

GRANT INSERT ON "postings" TO "ledger_app";

GRANT INSERT ON "outbox" TO "ledger_app";

GRANT INSERT ON "txn_anomalies" TO "ledger_app";

GRANT INSERT ON "accounts" TO "ledger_app";

GRANT INSERT ON "txn_records" TO "ledger_app";

GRANT INSERT ON "txn_keys" TO "ledger_app";

GRANT INSERT ON "txn_scheduled" TO "ledger_app";

GRANT INSERT ON "fx_rates" TO "ledger_app";

GRANT INSERT ON "txn_holds" TO "ledger_app";

GRANT INSERT ON "txn_disputes" TO "ledger_app";

GRANT UPDATE ("status", "released_by_transition_id", "released_at")
ON "txn_holds" TO "ledger_app";

GRANT UPDATE ("status", "resolved_at", "resolution")
ON "txn_disputes" TO "ledger_app";

GRANT UPDATE ("state", "version", "active_keys", "compromised", "updated_at")
ON "txn_records" TO "ledger_app";

GRANT UPDATE ("balance") ON "accounts" TO "ledger_app";

GRANT UPDATE ("status", "consumed_by_transition_id")
ON "txn_keys" TO "ledger_app";

GRANT UPDATE ("delivered_at", "attempts", "next_attempt_at", "last_error")
ON "outbox" TO "ledger_app";

GRANT UPDATE ("resolved_at", "resolved_by", "resolution")
ON "txn_anomalies" TO "ledger_app";

GRANT UPDATE ("status", "attempts", "last_error", "fired_at", "fired_transition_id")
ON "txn_scheduled" TO "ledger_app";

"
`;
