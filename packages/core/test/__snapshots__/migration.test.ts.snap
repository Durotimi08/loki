ALTER TABLE "postings" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "txn_keys_tenant_isolation" ON "txn_keys";

ALTER TABLE "txn_keys" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "txn_transitions_tenant_isolation" ON "txn_transitions";

ALTER TABLE "txn_transitions" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "txn_records_tenant_isolation" ON "txn_records";

ALTER TABLE "txn_records" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "accounts_tenant_isolation" ON "accounts";

ALTER TABLE "accounts" DISABLE ROW LEVEL SECURITY;

DROP INDEX IF EXISTS "txn_transitions_init_idem_idx";

DROP INDEX IF EXISTS "txn_scheduled_due_idx";

DROP INDEX IF EXISTS "txn_anomalies_severity_idx";

