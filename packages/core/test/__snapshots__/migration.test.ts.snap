ALTER TABLE "fx_rates" DISABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "txn_scheduled_tenant_isolation" ON "txn_scheduled";

ALTER TABLE "txn_scheduled" DISABLE ROW LEVEL SECURITY;

