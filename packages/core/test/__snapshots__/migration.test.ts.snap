"REVOKE ALL ON ALL TABLES IN SCHEMA public FROM "ledger_app";
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM "ledger_admin";

DROP POLICY IF EXISTS "txn_disputes_tenant_isolation" ON "txn_disputes";

