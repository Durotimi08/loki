#!/usr/bin/env bash
# Pre-push hook: when pushing main to origin, sync Loki tarballs into
# chidori-new before the push completes.
#
# Install with:   pnpm hooks:install
# Bypass once:    git push --no-verify
# Bypass always:  LOKI_SKIP_SHIP=1 git push
set -euo pipefail

if [[ "${LOKI_SKIP_SHIP:-0}" == "1" ]]; then
  exit 0
fi

REMOTE="$1"

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
PUSHING_MAIN=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    PUSHING_MAIN=1
  fi
done

if [[ "$PUSHING_MAIN" -eq 0 ]]; then
  exit 0
fi

if [[ "$REMOTE" != "origin" ]]; then
  # Only sync on pushes to origin.
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/scripts/ship.sh"
